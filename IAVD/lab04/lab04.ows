		<properties node_id="25" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00$\x00\x00\x05\xbd\x00\x00\x03\xbb\x00\x00\x00\x00\x00\x00\x00$\x00\x00\x05\xbd\x00\x00\x03\xbb\x00\x00\x00\x00\x00\x04\x00\x00\x05\xbe\x00\x00\x00\x00\x00\x00\x00$\x00\x00\x05\xbd\x00\x00\x03\xbb', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': False, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="26" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 1, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00$\x00\x00\x05\xbd\x00\x00\x03\xbb\x00\x00\x00\x00\x00\x00\x00$\x00\x00\x05\xbd\x00\x00\x03\xbb\x00\x00\x00\x00\x00\x04\x00\x00\x05\xbe\x00\x00\x00\x00\x00\x00\x00$\x00\x00\x05\xbd\x00\x00\x03\xbb', 'scriptLibrary': [{'name': 'New script', 'script': "from sklearn.neighbors import KNeighborsClassifier\nfrom Orange.classification import Model\nimport Orange\nimport numpy as np\n\n# 1. Отримання ознак (X) та цільової змінної (Y)\nX = in_data.X\n# Y має бути одновимірним масивом цілих чисел для Scikit-learn\nY = in_data.Y.flatten().astype(int)\n\n# 2. Створення та навчання класифікатора K-Nearest Neighbors з K=5\nlearner = KNeighborsClassifier(n_neighbors=5)\nmodel = learner.fit(X, Y)\n\n# 3. Обгортання моделі Scikit-learn у формат Orange Model\n# Це обов'язкова змінна для виводу моделі на порт Learner\nout_model = Orange.classification.Model(model, in_data.domain)", 'filename': None}, {'name': 'New script', 'script': 'from Orange.classification import Learner, Model\nimport numpy as np\n\nclass AutoThresholdClassifier(Learner):\n    name = "My Auto-Threshold Classifier"\n\n    def __init__(self, feature_index=0):\n        super().__init__()\n        self.feature_index = feature_index\n\n    def fit(self, X, Y, W=None):\n        feature_values = X[:, self.feature_index]\n        unique_vals = np.unique(feature_values)\n\n        best_threshold = None\n        best_accuracy = 0\n\n        for threshold in unique_vals:\n            pred = np.where(feature_values &gt; threshold, 1, 0)\n            acc = np.mean(pred == Y)\n            if acc &gt; best_accuracy:\n                best_accuracy = acc\n                best_threshold = threshold\n\n        if best_threshold is None:\n            best_threshold = np.mean(feature_values)\n\n        unique_classes = np.unique(Y)\n        class_a, class_b = unique_classes[0], unique_classes[1]\n\n        return AutoThresholdModel(self.feature_index, best_threshold, class_a, class_b)\n\nclass AutoThresholdModel(Model):\n    def __init__(self, feature_index, threshold, class_a, class_b):\n        self.feature_index = feature_index\n        self.threshold = threshold\n        self.class_a = class_a\n        self.class_b = class_b\n\n    def predict(self, X):\n        pred = np.where(X[:, self.feature_index] &gt; self.threshold, self.class_b, self.class_a)\n        return pred\n\nlearner = AutoThresholdClassifier(feature_index=0)\n\nout_learner = learner', 'filename': None}], 'scriptText': 'from Orange.classification import Learner, Model\nimport numpy as np\n\nclass AutoThresholdClassifier(Learner):\n    name = "My Auto-Threshold Classifier"\n\n    def __init__(self, feature_index=0):\n        super().__init__()\n        self.feature_index = feature_index\n\n    def fit(self, X, Y, W=None):\n        feature_values = X[:, self.feature_index]\n        unique_vals = np.unique(feature_values)\n\n        best_threshold = None\n        best_accuracy = 0\n\n        for threshold in unique_vals:\n            pred = np.where(feature_values &gt; threshold, 1, 0)\n            acc = np.mean(pred == Y)\n            if acc &gt; best_accuracy:\n                best_accuracy = acc\n                best_threshold = threshold\n\n        if best_threshold is None:\n            best_threshold = np.mean(feature_values)\n\n        unique_classes = np.unique(Y)\n        class_a, class_b = unique_classes[0], unique_classes[1]\n\n        return AutoThresholdModel(self.feature_index, best_threshold, class_a, class_b)\n\nclass AutoThresholdModel(Model):\n    def __init__(self, feature_index, threshold, class_a, class_b):\n        self.feature_index = feature_index\n        self.threshold = threshold\n        self.class_a = class_a\n        self.class_b = class_b\n\n    def predict(self, X):\n        pred = np.where(X[:, self.feature_index] &gt; self.threshold, self.class_b, self.class_a)\n        return pred\n\nlearner = AutoThresholdClassifier(feature_index=0)\n\nout_learner = learner', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
